# Flowstate on Thru — example configuration. Copy to .env (git-ignored). NO SECRETS HERE.
# Keys are never stored in this repository or in frontend code; the thru CLI keeps its own
# key file in ~/.thru/cli/config.yaml, which must never be committed or printed.

# Network profile name used by the thru CLI (alphanet or betanet; not assumed identical).
THRU_NETWORK=
# RPC URL override (optional). Thru hosts were unreachable from the development environment.
THRU_RPC_URL=
# Flowstate program address after deployment (empty until a real deployment exists).
FLOWSTATE_PROGRAM_ADDRESS=
# Token program address on the chosen network. Do not fill from memory: confirm on the network.
THRU_TOKEN_PROGRAM_ADDRESS=
# Test-token mint created for this project (never USDC, never a real-value token).
FLOWSTATE_TEST_MINT=
# App mode: "local-simulation" (default) or "testnet" (disabled until testnet is reachable).
FLOWSTATE_MODE=local-simulation
